# garage.toml
metadata_dir = "/var/lib/garage/meta"
data_dir     = "/var/lib/garage/data"
db_engine    = "sqlite"
replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_secret    = "{{openssl rand -hex 32}}"

[s3_api]
api_bind_addr = "[::]:3900"
s3_region     = "garage"
root_domain   = ".s3.local"

[admin]
api_bind_addr = "[::]:3903"
admin_token   = "{{openssl rand -base64 32}}"